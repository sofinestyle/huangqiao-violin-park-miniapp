# Copy to ignored .env; never commit real passwords, API Keys, or connection URLs.
APP_ENV=development
PORT=8787
DATABASE_URL=postgresql://hq_dev:REPLACE_LOCALLY@127.0.0.1:55432/hq_development
PGSCHEMA=app
PGPOOL_MAX=10
LOCAL_DEV_AUTH=false
HQ_SEED_MODE=none
STORAGE_PROVIDER=local
HQ_UPLOAD_DIR=.local/uploads
# Staging/production: HTTPS origin only, CloudBase private bucket, no test seed/auth.
ADMIN_ORIGIN=
CLOUDBASE_ENV_ID=
CLOUDBASE_BUCKET=
CLOUDBASE_SERVICE_ROLE_KEY=
WX_APPID=
WX_APPSECRET=
# Bootstrap is an explicit one-time command; password is read from env, never printed.
# BOOTSTRAP_PASSWORD=
# TEST_DATABASE_URL=postgresql://...@127.0.0.1:55432/hq_test_phase1
# Backup retention applies to backup copies, never to business tables.
DB_BACKUP_INTERVAL_DAYS=3
IMAGE_BACKUP_INTERVAL_DAYS=7
BACKUP_RETENTION_DAYS=30
