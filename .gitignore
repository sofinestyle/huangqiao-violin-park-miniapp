# macOS metadata
.DS_Store
._*

# Dependencies and generated build output
node_modules/
dist/
build/
coverage/
__pycache__/
*.pyc
*.log

# Local credentials and developer private configuration
.env
.env.*
!.env.example
project.private.config.json
*.pem
*.key
secrets/

# Additional certificate and authentication files excluded from remote uploads
*.p12
*.pfx
*.p8
*.p7b
*.p7c
*.jks
*.keystore
*.crt
*.cer
.npmrc
.netrc
.pypirc
.aws/
.ssh/
credentials*.json
*service-account*.json

# Business personal data, backups and temporary QA output
data-private/
exports/
backups/
.local/
.qa/

# User local archive is retained locally, never included in this repository
/归档.zip

# Published videos live in managed media storage, never in source control
*.mp4
*.mov
*.m4v
*.webm

# Local databases and native compiler output
*.sqlite
*.sqlite-shm
*.sqlite-wal
miniprogram/miniprogram/**/*.js
miniprogram/miniprogram/**/*.js.map

# Restored isolated copies must never enter Git
.local-restored*/
