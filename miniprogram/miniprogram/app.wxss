page{background:#f7f3e9;color:#3c2c20;font-family:-apple-system,"PingFang SC",sans-serif;font-size:28rpx;line-height:1.7}view,text,input,textarea,button{box-sizing:border-box}button{font-size:28rpx;border-radius:10rpx;margin:0;padding:18rpx 28rpx;line-height:1.5;background:#4b3325;color:#fff}button::after{border:none}button[disabled]{background:#c2b3a1;color:#fff}button.secondary{background:transparent;color:#826742;border:1rpx solid #cbb897}button.text-button{background:transparent;color:#967548;padding:8rpx 0;font-size:26rpx}.page{padding:30rpx 32rpx 50rpx}.test-notice{font-size:21rpx;color:#8f7a5c;background:#eee7d8;text-align:center;padding:9rpx 14rpx}.brand-bar{display:flex;align-items:center;padding:20rpx 32rpx;background:#fffdf7}.brand-bar image{width:100rpx;height:62rpx;flex-shrink:0;margin-right:24rpx}.brand-bar text{font-family:"Songti SC",STSong,serif;font-size:31rpx;font-weight:600;letter-spacing:1rpx}.h1{font-family:"Songti SC",STSong,serif;font-size:46rpx;line-height:1.45;font-weight:600;margin-bottom:16rpx}.h2{font-family:"Songti SC",STSong,serif;font-size:36rpx;font-weight:600;margin:34rpx 0 18rpx}.h3{font-family:"Songti SC",STSong,serif;font-size:31rpx;font-weight:600;margin:12rpx 0}.muted{color:#8a795f;font-size:24rpx}.pre-line{white-space:pre-line}.intro{font-size:26rpx;line-height:1.95;color:#6c5942}.section{margin-bottom:38rpx}.section-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:20rpx}.section-title .h2{margin:0}.cover{width:100%;height:320rpx;display:block;border-radius:16rpx}.card{background:#fffdf7;border:1rpx solid #e6dcc7;border-radius:18rpx;overflow:hidden;margin-bottom:24rpx}.card-body{padding:22rpx 26rpx}.card .cover{border-radius:0;height:270rpx}.grid{display:grid;grid-template-columns:1fr 1fr;gap:22rpx}.grid .card{margin:0}.grid .cover{height:220rpx}.price{font-size:28rpx;color:#95713e;margin-top:12rpx}.tag{display:inline-block;font-size:21rpx;color:#8b6b3e;border:1rpx solid #d9c7a6;border-radius:6