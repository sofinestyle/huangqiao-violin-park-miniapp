<import src="../../templates/state.wxml"/>
<view class="visitor-page"><view class="visitor-brand"><image class="visitor-logo" src="/assets/yorray-logo.png" mode="aspectFit" aria-label="YorRay"/><text class="visitor-brand-name">游客预约申请</text></view>
<view class="page"><view wx:if="{{enrollmentId || group}}" class="h1">{{enrollmentId?'研学跟团报名':'团体需求申请'}}</view><view class="intro">申请保存后由工作人员联系并确认，提交不代表接待已生效。</view><template is="state" data="{{loading,error}}"/><block wx:if="{{!loading && !error}}"><block wx:if="{{enrollmentId}}"><view class="panel"><view class="h3">{{activity.title}}</view><view>套餐：{{activity.packageName}}</view><view>日期：{{activity.date}}</view><view>时段：{{activity.start}}—{{activity.end}}</view><view class="pre-line">集合地点：{{activity.meetingPoint}}</view><view class="muted">剩余名额 {{activity.remaining}} 人，提交申请不锁定名额。</view><view wx:if="{{!activity.canApply}}" class="error">{{activity.availabilityLabel}}，请返回选择其他活动。</view></view></block><block wx:else><view class="field"><text class="label">{{group?'意向套餐（可不指定）':'研学套餐'}}</text><picker range="{{packages}}" range-key="name" bindchange="pickPackage"><view class="picker-value">{{packageName}}</view></picker></view><view class="field"><text class="label">意向日期</text><picker mode="date" start="{{minDate}}" value="{{form.date}}" bindchange="date"><view class="picker-value">{{form.date || '请选择日期'}}</view></picker></view><view class="field"><text class="label">意向时间段（可选）</text><input value="{{form.preferredTime}}" data-key="preferredTime" bindinput="input" maxlength="100" placeholder="例如：上午9:00—11:00"/><view class="support-note">请填写希望到访的时间段，具体安排由工作人员确认。</view></view></block><view class="field" wx:if="{{group}}"><text class="label">单位 / 团队名称</text><input value="{{form.team}}" data-key="team" bindinput="input" maxlength="120"/></view><view class="pair" wx:if="{{!group}}"><view class="field"><text class="label">成人数</text><input type="number" value="{{form.adults}}" data-key="adults" bindinput="input" placeholder="请输入人数"/></view><view class="field"><text class="label">儿童数</text><input type="number" value="{{form.children}}" data-key="children" bindinput="input" placeholder="请输入人数"/></view></view><view class="field" wx:if="{{group}}"><text class="label">预计总人数</text><input type="number" value="{{form.total}}" data-key="total" bindinput="input"/></view><view class="field"><text class="label">联系人</text><input value="{{form.contactName}}" data-key="contactName" bindinput="input" maxlength="60"/></view><view class="field"><text class="label">中国大陆手机号</text><input type="number" value="{{form.phone}}" data-key="phone" bindinput="input" maxlength="11"/></view><view class="field"><text class="label">{{group?'团体需求说明（必填）':'备注（可选）'}}</text><textarea value="{{form.note}}" data-key="note" bindinput="input" maxlength="1500" placeholder="请填写必要的接待需求"/></view><view class="support-note">请按实际参加人数填写，具体费用与接待安排由工作人员联系确认。</view><checkbox-group bindchange="consent"><label class="checkbox-row"><checkbox value="agree" checked="{{form.consent}}" color="#967548"/><text>我已阅读<text class="booking-privacy-link" catchtap="privacy">隐私与服务说明</text>，同意为此申请保存必要信息。</text></label></checkbox-group><view wx:if="{{submitError}}" class="error">{{submitError}}</view><button bindtap="submit" loading="{{busy}}" disabled="{{busy || (enrollmentId && !activity.canApply)}}">{{busy?'正在保存…':'提交预约申请'}}</button></block></view>
</view>
