<import src="../../templates/state.wxml"/><view class="page"><view class="h1">{{enrollmentId?'研学跟团报名':group?'团体需求申请':'个人 / 家庭预约申请'}}</view><view class="intro">申请保存后由工作人员联系并确认，提交不代表接待已生效。</view><template is="state" data="{{loading,error}}"/><block wx:if="{{!loading && !error}}"><block wx:if="{{enrollmentId}}"><view class="panel"><view class="h3">{{activity.title}}</view><view>套餐：{{activity.packageName}}</view><view>日期：{{activity.date}}</view><view>时段：{{activity.start}}—{{activity.end}}</view><view class="pre-line">集合地点：{{activity.meetingPoint}}</view><view class="muted">剩余名额 {{activity.remaining}} 人，提交申请不锁定名额。</view><view wx:if="{{!activity.canApply}}" class="error">{{activity.availabilityLabel}}，请返回选择其他活动。</view></view></block><block wx:else><view class="field"><text class="label">{{group?'意向套餐（可不指定）':'研学套餐'}}</text><picker range="{{packages}}" range-key="name" bindchange="pickPackage"><view class="picker-value">{{packageName}}</view></picker></view><view class="field"><text class="label">意向日期</text><picker mode="date" start="{{minDate}}" value="{{form.date}}" bindchange="date"><view class="picker-value">{{form.date || '请选择日期'}}</view></picker></view><view class="field"><text class="label">意向时段（可选）</text><picker wx:if="{{filteredSlots.length}}" range="{{filteredSlots}}" range-key="label" bindchange="slot"><view class="picker-value">{{slotLabel}}</view></picker><view wx:else class="picker-value muted">该日暂无已配置时段，提交后人工沟通</view><button wx:if="{{form.slotId}}" class="text-button" bindtap="clearSlot">清除意向时段</button></view></block><view class="field" wx:if="{{group}}"><text class="label">单位 / 团队名称</text><input value="{{form.team}}" data-key="team" bindinput="input" maxlength="120"/></view><view class="pair" wx:if="{{!group}}"><view class="field"><text class="label">成人数</text><input type="number" value="{{form.adults}}" data-key="adults" bindinput="input" placeholder="请输入人数"/></view><view class="field"><text class="label">儿童数</text><input type="number" value="{{form.children}}" data-key="children" bindinput="input" placeholder="请输入人数"/></view></view><view class="field" wx:if="{{group}}"><text class="label">预计总人数</text><input type="number" value="{{form.total}}" data-key="total" bindinput="input"/></view><view class="field"><text class="label">联系人</text><input value="{{form.contactName}}" data-key="contactName" bindinput="input" maxlength="60"/></view><view class="field"><text class="label">中国大陆手机号</text><input type="number" value="{{form.phone}}" data-key="phone" bindinput="input" maxlength="11"/></view><view class="field"><text class="label">{{group?'团体需求说明（必填）':'备注（可选）'}}</text><textarea value="{{form.note}}" data-key="note" bindinput="input" maxlength="1500" placeholder="请填写必要的接待需求"/></view><view class="support-note">请按实际参加人数填写，具体费用与接待安排由工作人员联系确认。</view><checkbox-group bindchange="consent"><label class="checkbox-row"><checkbox value="agree" checked="{{form.consent}}" color="#967548"/><text>我已阅读隐私与服务说明，同意为此申请保存必要信息。</text></label></checkbox-group><button class="text-button" bindtap="privacy">查看资料使用与服务说明</button><view wx:if="{{submitError}}" class="error">{{submitError}}</view><button bindtap="submit" loading="{{busy}}" disabled="{{busy || (enrollmentId && !activity.canApply)}}">{{busy?'正在保存…':'提交预约申请'}}</button></block></view>
