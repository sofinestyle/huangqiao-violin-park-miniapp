/* Brand page only: approved Design System values, no shared token changes. */
.brand-page { --brand-bg: #F7F3E9; --brand-surface: #FFFDF7; --brand-walnut: #3C2B24; --brand-text: #3C2C20; --brand-secondary: #6C5948; --brand-error: #A13E35; --brand-serif: "Songti SC", STSong, "Noto Serif CJK SC", serif; --brand-sans: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif; }
.brand-page { min-height: 100vh; box-sizing: border-box; background: var(--brand-bg); color: var(--brand-text); font-family: var(--brand-sans); padding-bottom: 32px; }
.brand-heading { padding: 28px 24px 24px; text-align: center; }
.brand-logo { width: 112px; height: 64px; background: var(--brand-walnut); border-radius: 4px; }
.brand-title { margin-top: 16px; font-family: var(--brand-serif); font-size: 28px; font-weight: 700; line-height: 1.4; }
.brand-subtitle { margin-top: 6px; color: var(--brand-secondary); font-size: 14px; line-height: 1.6; }
.brand-photo { display: block; width: 100%; height: 240px; background: var(--brand-walnut); }
.brand-content { padding: 28px 24px 0; }
.brand-section-title { color: var(--brand-secondary); font-size: 14px; line-height: 1.6; }
.brand-company { margin-top: 8px; font-family: var(--brand-serif); font-size: 20px; font-weight: 600; line-height: 1.6; }
.brand-intro { margin-top: 18px; font-size: 15px; line-height: 1.9; white-space: pre-line; }
.brand-actions { display: flex; gap: 12px; padding: 28px 24px 0; }
.brand-actions button { flex: 1; margin: 0; min-height: 48px; padding: 12px 8px; border: 0; border-radius: 8px; font-size: 15px; line-height: 1.6; }
.brand-actions button::after { border: 0; }
.brand-actions .brand-primary { background: var(--brand-walnut); color: var(--brand-surface); }
.brand-actions .brand-secondary { background: #EDE5D7; color: var(--brand-walnut); }
.brand-empty, .brand-page .loading, .brand-page .error { margin: 24px; padding: 20px; background: var(--brand-surface); color: var(--brand-secondary); font-size: 15px; line-height: 1.7; }
.brand-page .error { color: var(--brand-error); }
.brand-page .error button { min-height: 44px; background: var(--brand-walnut); color: var(--brand-surface); font-size: 15px; }
.brand-pressed { opacity: .72; }
@media (max-width:340px) { .brand-heading { padding-top: 24px; } .brand-content { padding-left: 20px; padding-right: 20px; } .brand-actions { padding-left: 20px; padding-right: 20px; } }
