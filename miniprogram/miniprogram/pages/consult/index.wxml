<import src="../../templates/state.wxml"/><view class="test-notice">本地咨询验证 · 不代表购买或报名</view><view class="page"><view class="h1">联系咨询</view><template is="state" data="{{loading,error}}"/><block wx:if="{{!loading && !error}}"><view class="panel" wx:if="{{item}}"><view class="h3">{{item.name}}</view><view class="muted">编码 {{item.code}}</view><view wx:if="{{spec}}">已选规格：{{spec}}</view></view><view class="muted" wx:if="{{!item}}">咨询来源：{{source}}</view><view class="field"><text class="label">联系人</text><input value="{{form.contactName}}" data-key="contactName" bindinput="input" maxlength="60"/></view><view class="field"><text class="label">中国大陆手机号</text><input type="number" value="{{form.phone}}" data-key="phone" bindinput="input" maxlength="11"/></view><view class="field"><text class="label">咨询内容</text><textarea value="{{form.message}}" data-key="message" bindinput="input" maxlength="1500"/></view><checkbox-group bindchange="consent"><label class="checkbox-row"><checkbox value="agree" checked="{{form.consent}}" color="#967548"/><text>我已阅读测试环境资料使用说明，同意为此咨询保存必要信息。</text></label></checkbox-group><button class="text-button" bindtap="privacy">查看资料使用说明</button><view wx:if="{{submitError}}" class="error">{{submitError}}</view><button bindtap="submit" loading="{{busy}}" disabled="{{busy}}">提交测试咨询</button></block></view>
