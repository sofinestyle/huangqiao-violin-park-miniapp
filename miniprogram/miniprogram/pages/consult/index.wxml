<import src="../../templates/state.wxml"/>
<view class="visitor-page">
  <view class="visitor-brand">
    <image class="visitor-logo" src="/assets/yorray-logo.png" mode="aspectFit" aria-label="YorRay"/>
    <text class="visitor-brand-name">产品与服务咨询</text>
  </view>
  <view class="page"><template is="state" data="{{loading,error}}"/><block wx:if="{{!loading && !error}}"><view class="panel" wx:if="{{item}}"><view class="h3">{{item.name}}</view><view wx:if="{{item.code}}" class="muted">编码 {{item.code}}</view><view wx:if="{{specLabel}}">已选规格：{{specLabel}}</view><view wx:if="{{skuNotice}}" class="muted">{{skuNotice}}</view><button wx:if="{{item.kind==='product' && item.variantMode==='options'}}" class="secondary" bindtap="chooseSku">重新选择规格</button></view><view class="muted" wx:if="{{!item}}">咨询来源：{{source}}</view><view class="field"><text class="label">联系人</text><input value="{{form.contactName}}" data-key="contactName" bindinput="input" maxlength="60"/></view><view class="field"><text class="label">中国大陆手机号</text><input type="number" value="{{form.phone}}" data-key="phone" bindinput="input" maxlength="11"/></view><view class="field"><text class="label">咨询内容</text><textarea value="{{form.message}}" data-key="message" bindinput="input" maxlength="1500"/></view><checkbox-group bindchange="consent"><label class="checkbox-row"><checkbox value="agree" checked="{{form.consent}}" color="#967548"/><view>我已阅读<text class="consult-privacy-link" catchtap="privacy">隐私与服务说明</text>，同意为此咨询保存必要信息。</view></label></checkbox-group><view wx:if="{{submitError}}" class="error">{{submitError}}</view><button bindtap="submit" loading="{{busy}}" disabled="{{busy || loading || !canSubmit}}">提交咨询</button></block></view>
  <view class="park-tabs">
    <navigator class="park-tab" url="/pages/index/index" open-type="switchTab" hover-class="park-tab-pressed" aria-role="button" aria-label="首页">
      <image class="park-tab-icon" src="/assets/tab-icons/home-muted.png" mode="aspectFit"/>
      <text class="park-tab-label">首页</text><view class="park-tab-line"/>
    </navigator>
    <navigator class="park-tab {{item && item.kind === 'product' && item.category !== 'gift' ? 'park-tab-selected' : ''}}" url="/pages/instruments/index" open-type="switchTab" hover-class="park-tab-pressed" aria-role="button" aria-label="乐器">
      <image class="park-tab-icon" src="/assets/tab-icons/instrument-{{item && item.kind === 'product' && item.category !== 'gift' ? 'active' : 'muted'}}.png" mode="aspectFit"/>
      <text class="park-tab-label">乐器</text><view class="park-tab-line"/>
    </navigator>
    <navigator class="park-tab {{item && item.kind === 'product' && item.category === 'gift' ? 'park-tab-selected' : ''}}" url="/pages/gifts/index" open-type="switchTab" hover-class="park-tab-pressed" aria-role="button" aria-label="文创">
      <image class="park-tab-icon" src="/assets/tab-icons/gift-{{item && item.kind === 'product' && item.category === 'gift' ? 'active' : 'muted'}}.png" mode="aspectFit"/>
      <text class="park-tab-label">文创</text><view class="park-tab-line"/>
    </navigator>
    <navigator class="park-tab {{item && item.kind === 'package' ? 'park-tab-selected' : ''}}" url="/pages/study/index" open-type="switchTab" hover-class="park-tab-pressed" aria-role="button" aria-label="研学">
      <image class="park-tab-icon" src="/assets/tab-icons/study-{{item && item.kind === 'package' ? 'active' : 'muted'}}.png" mode="aspectFit"/>
      <text class="park-tab-label">研学</text><view class="park-tab-line"/>
    </navigator>
    <navigator class="park-tab" url="/pages/mine/index" open-type="switchTab" hover-class="park-tab-pressed" aria-role="button" aria-label="我的">
      <image class="park-tab-icon" src="/assets/tab-icons/mine-muted.png" mode="aspectFit"/>
      <text class="park-tab-label">我的</text><view class="park-tab-line"/>
    </navigator>
  </view>

</view>
