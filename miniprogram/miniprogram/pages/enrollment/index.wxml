<import src="../../templates/state.wxml"/>
<view class="page"><template is="state" data="{{loading,error}}"/><block wx:if="{{item && !loading && !error}}"><image wx:if="{{item.cover}}" class="cover" src="{{item.cover}}" mode="aspectFill"/><view class="h1">{{item.title}}</view><view class="tag">已成团 · {{item.availabilityLabel}}</view>
<view class="panel"><view class="detail-line"><text class="key">活动日期</text><text>{{item.date}}</text></view><view class="detail-line"><text class="key">接待时段</text><text>{{item.start}}—{{item.end}}</text></view><view class="detail-line"><text class="key">研学套餐</text><text>{{item.packageName}}</text></view><view class="detail-line"><text class="key">集合地点</text><text>{{item.meetingPoint}}</text></view><view class="price">剩余名额 {{item.remaining}} 人</view><view class="muted">名额以工作人员确认时为准，待确认申请不占名额。</view></view>
<view class="h2">活动介绍</view><view class="intro pre-line">{{item.description}}</view><view class="h2">费用说明</view><view class="intro pre-line">{{item.feeNote || '具体费用请联系工作人员确认。'}}</view><view class="h2">报名说明</view><view class="intro pre-line">{{item.registrationNote || '请按实际参加人数填写报名申请，提交后由工作人员联系确认安排。'}}</view><view class="actions"><button class="secondary" bindtap="package">了解套餐内容</button><button class="secondary" bindtap="consult">套餐咨询</button></view>
<view class="sticky-action"><button bindtap="apply" disabled="{{!item.canApply}}">{{item.canApply?'申请跟团报名':item.availabilityLabel}}</button></view></block></view>
