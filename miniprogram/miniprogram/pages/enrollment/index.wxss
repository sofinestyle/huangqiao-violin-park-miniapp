/* Page-local brand shell: follows the accepted tour page without changing global styles. */
.visitor-page {
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
  background: #f5eddd;
  color: #403326;
}
.visitor-page .visitor-brand {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 24rpx;
  height: 55px;
  padding: 0 40rpx;
  background: #3c2b24;
}
.visitor-page .visitor-logo {
  flex-shrink: 0;
  width: 139.2rpx;
  height: 86.4rpx;
  background: transparent;
  border-radius: 4rpx;
}
.visitor-page .visitor-brand-name {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  white-space: nowrap;
  text-align: center;
  color: #fff;
  font-family: "Microsoft YaHei", "微软雅黑", "PingFang SC", sans-serif;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1.4;
  letter-spacing: 1rpx;
}
@media (max-width: 320px) {
  .visitor-page .visitor-brand { gap: 20rpx; }
  .visitor-page .visitor-brand-name { font-size: 32rpx; }
}
