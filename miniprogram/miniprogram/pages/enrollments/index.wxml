<import src="../../templates/state.wxml"/>
<view class="visitor-page"><view class="visitor-brand"><image class="visitor-logo" src="/assets/yorray-logo.png" mode="aspectFit" aria-label="YorRay"/><text class="visitor-brand-name">研学跟团报名</text></view>
<view class="page"><view class="intro">选择已成团的活动，申请加入研学之旅。</view><view class="support-note">报名申请保存后，由工作人员联系并确认接待；提交不代表名额已保留。</view>
<view class="field"><text class="label">按日期查看</text><picker mode="date" value="{{date}}" bindchange="date"><view class="picker-value">{{date || '全部活动日期'}}</view></picker><button wx:if="{{date}}" class="text-button" bindtap="clear">查看全部日期</button></view>
<template is="state" data="{{loading,error}}"/>
<block wx:if="{{!loading && !error}}"><view class="card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><image wx:if="{{item.cover}}" class="cover" src="{{item.cover}}" mode="aspectFill"/><view class="card-body"><view class="tag">已成团 · {{item.availabilityLabel}}</view><view class="h3">{{item.title}}</view><view>{{item.date}} {{item.start}}—{{item.end}}</view><view class="muted">{{item.packageName}}</view><view class="intro pre-line">集合地点：{{item.meetingPoint}}</view><view class="price">剩余名额 {{item.remaining}} 人</view><button class="secondary" data-id="{{item.id}}" catchtap="open">查看活动与报名</button></view></view><view wx:if="{{!items.length}}" class="empty">{{date?'该日暂无已发布的报名活动，请查看其他日期。':'暂无已发布的报名活动，请稍后查看或联系工作人员。'}}</view></block></view>
</view>
