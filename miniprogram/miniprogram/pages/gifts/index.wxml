<import src="../../templates/state.wxml"/>
<view class="visitor-page">
  <view class="visitor-brand">
    <image class="visitor-logo" src="/assets/yorray-logo.png" mode="aspectFit" aria-label="YorRay"/>
    <text class="visitor-brand-name">文创伴手礼</text>
  </view>
  <view class="page"><input class="search" placeholder="搜索名称或产品编码" value="{{q}}" bindinput="search"/><scroll-view scroll-x class="filters"><view wx:for="{{filters}}" wx:key="*this" class="filter {{selected===item?'on':''}}" data-filter="{{item}}" bindtap="select">{{item}}</view></scroll-view><template is="state" data="{{loading,error}}"/><view class="grid" wx:if="{{!loading}}"><view class="card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view class="product-square"><image class="cover" src="{{item.cover}}" mode="aspectFill"/></view><view class="card-body"><view class="tag">{{item.series}}</view><view class="h3">{{item.name}}</view><view class="price">{{item.priceLabel}}</view></view></view></view><view wx:if="{{!loading && !error && !items.length}}" class="empty">暂无符合条件的产品</view></view>
</view>
