<import src="../../templates/state.wxml"/>
<view class="home">
  <view class="home-brand">
    <image class="home-logo" src="/assets/yorray-logo.png" mode="aspectFit"/>
    <text class="home-brand-name">黄桥琴旅</text>
  </view>
  <template is="state" data="{{loading,error}}"/>
  <block wx:if="{{site}}">
    <view class="home-hero">
      <view class="home-hero-media">
        <image class="home-hero-image" src="{{site.images[1]}}" mode="aspectFill"/>
        <view class="home-hero-shade"/>
      </view>
      <view class="home-hero-caption">
        <view class="home-hero-title">{{site.heroTitle}}</view>
        <view class="home-hero-title home-hero-subtitle">{{site.heroSubtitle}}</view>
        <view class="home-hero-note">{{site.intro}}</view>
      </view>
    </view>
    <view class="home-hero-links">
      <view class="home-hero-action" data-page="tour" bindtap="open" hover-class="home-pressed"><text>探索园区</text><text class="home-arrow">→</text></view>
    </view>
    <view class="home-services">
      <view class="home-service-primary">
        <view class="home-entry home-entry-instruments" data-page="instruments" bindtap="tab" hover-class="home-pressed">
          <image class="home-service-image" src="{{spots[0].cover || site.images[1]}}" mode="aspectFill"/>
          <view class="home-entry-caption"><view class="home-entry-title">乐器展示<text class="home-entry-arrow">↗</text></view><view class="home-entry-note">展示与咨询</view></view>
        </view>
        <view class="home-entry home-entry-study" data-page="study" bindtap="tab" hover-class="home-pressed">
          <image class="home-service-image" src="{{packages[0].cover || site.images[1]}}" mode="aspectFill"/>
          <view class="home-entry-caption"><view class="home-entry-title">研学套餐<text class="home-entry-arrow">↗</text></view><view class="home-entry-note">人工确认安排</view></view>
        </view>
      </view>
      <view class="home-service-secondary">
        <view class="home-entry home-entry-small" data-page="gifts" bindtap="tab" hover-class="home-pressed">
          <image class="home-service-image" src="{{packages[0].cover || site.images[1]}}" mode="aspectFill"/>
          <view class="home-entry-copy"><view class="home-entry-title">文创伴手礼</view><view class="home-entry-note">把琴音带回家</view></view><text class="home-entry-arrow">↗</text>
        </view>
        <view class="home-entry home-entry-small" data-page="teaching" bindtap="open" hover-class="home-pressed">
          <image class="home-service-image" src="{{spots[0].images[4] || packages[0].cover || site.images[1]}}" mode="aspectFill"/>
          <view class="home-entry-copy"><view class="home-entry-title">教学课堂</view><view class="home-entry-note">图文与公开视频</view></view><text class="home-entry-arrow">↗</text>
        </view>
      </view>
      <view class="home-service-support">
        <view class="home-entry" data-page="tour" bindtap="open" hover-class="home-pressed">点位导览<text class="home-entry-arrow">→</text></view>
        <view class="home-entry" data-page="consult" bindtap="open" hover-class="home-pressed">联系咨询<text class="home-entry-arrow">→</text></view>
      </view>
    </view>
    <view class="home-story">
      <view class="home-story-heading">把黄桥的琴音带回家</view>
      <view class="home-story-intro">从一块云杉到一把成琴，从城市客厅到智能工坊，在这里读懂一把琴的诞生，也把黄桥的琴音带回家。园区集乐器博览、工业研学、文创开发、提琴产销与艺术教学于一体。</view>
    </view>
    <view class="home-section home-explore">
      <view class="home-explore-visual">
        <image class="home-explore-image" src="{{spots[0].images[1] || spots[0].cover}}" mode="aspectFill"/>
        <view class="home-explore-shade"/>
        <view class="home-section-heading"><text class="home-section-number">01</text><view class="home-section-titles"><view class="home-section-english">EXPLORE THE PARK</view><view class="home-section-title">园区探索 · 琴音之旅</view></view></view>
        <view class="home-explore-caption"><view class="home-explore-note">从城市客厅到智能工坊</view><view class="home-guide-link" data-page="tour" bindtap="open" hover-class="home-pressed">进入探索<text class="home-arrow">→</text></view></view>
      </view>
      <view class="home-spots">
        <view wx:for="{{spots}}" wx:key="id" class="home-spot" data-page="spot" data-id="{{item.id}}" bindtap="open" hover-class="home-pressed">
          <image class="home-spot-image" src="{{item.cover}}" mode="aspectFill"/>
          <text class="home-spot-name">{{item.name==='产业园·中小企业集聚区'?'产业园':item.name==='绿岛·智能环保表面处理中心'?'绿岛':item.name}}</text><text class="home-spot-arrow">↗</text>
        </view>
      </view>
    </view>
    <view class="home-section home-recommended" wx:if="{{packages.length}}">
      <view class="home-section-heading"><text class="home-section-number">02</text><view class="home-section-titles"><view class="home-section-english">RECOMMENDED</view><view class="home-section-title">热门推荐</view></view></view>
      <view class="home-section-note">初次到访，从这两条路线开始</view>
      <view class="home-packages">
        <view class="home-package" wx:for="{{packages}}" wx:key="id" data-page="package" data-id="{{item.id}}" bindtap="open" hover-class="home-pressed">
          <image class="home-package-image" src="{{item.cover}}" mode="aspectFill"/>
          <view class="home-package-body"><view class="home-item-title">{{item.name}}</view><view class="home-package-meta"><view class="home-item-note">{{item.durationNote}}</view><view class="home-package-detail">详情<text class="home-arrow">↗</text></view></view></view>
        </view>
      </view>
    </view>
    <view class="home-footer">
      <view class="home-footer-brand">黄桥乐器文化产业园</view>
      <view class="home-notice" wx:if="{{site.notice}}">{{site.notice}}</view>
      <button class="home-about" data-page="about" bindtap="open" hover-class="home-pressed">关于我们与服务说明<text class="home-arrow">→</text></button>
    </view>
  </block>
</view>
