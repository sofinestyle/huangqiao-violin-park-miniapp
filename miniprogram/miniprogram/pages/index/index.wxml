<import src="../../templates/state.wxml"/>
<view class="home">
  <view class="home-brand">
    <image class="home-logo" src="/assets/yorray-logo.png" mode="aspectFit"/>
    <text class="home-brand-name">黄桥琴旅</text>
  </view>
  <template is="state" data="{{loading,error}}"/>
  <block wx:if="{{site}}">
    <view class="home-hero">
      <view class="home-hero-media">
        <image class="home-hero-image" src="{{site.images[1]}}" mode="aspectFill"/>
        <view class="home-hero-shade"/>
      </view>
      <view class="home-hero-caption">
        <view class="home-hero-title">{{site.heroTitle}}</view>
        <view class="home-hero-title home-hero-subtitle">{{site.heroSubtitle}}</view>
        <view class="home-hero-note">{{site.intro}}</view>
      </view>
    </view>
    <view class="home-quick-nav" aria-label="首页快捷导航">
      <view class="home-nav-item" bindtap="violin" hover-class="home-pressed" aria-role="button" aria-label="提琴选购">
        <image class="home-nav-icon" src="/assets/home-nav/violin.png" mode="aspectFit"/><text class="home-nav-label">提琴选购</text>
      </view>
      <view class="home-nav-item" data-page="brand" bindtap="open" hover-class="home-pressed" aria-role="button" aria-label="品牌介绍">
        <image class="home-nav-icon" src="/assets/home-nav/brand.png" mode="aspectFit"/><text class="home-nav-label">品牌介绍</text>
      </view>
      <view class="home-nav-item" data-page="teaching" bindtap="open" hover-class="home-pressed" aria-role="button" aria-label="教学课堂">
        <image class="home-nav-icon" src="/assets/home-nav/teaching.png" mode="aspectFit"/><text class="home-nav-label">教学课堂</text>
      </view>
      <view class="home-nav-item" data-page="tour" bindtap="open" hover-class="home-pressed" aria-role="button" aria-label="地图导览">
        <image class="home-nav-icon" src="/assets/home-nav/map.png" mode="aspectFit"/><text class="home-nav-label">地图导览</text>
      </view>
      <view class="home-nav-item" data-page="consult" bindtap="open" hover-class="home-pressed" aria-role="button" aria-label="预约咨询">
        <image class="home-nav-icon" src="/assets/home-nav/consult.png" mode="aspectFit"/><text class="home-nav-label">预约咨询</text>
      </view>
    </view>
    <view class="home-section home-explore">
      <view class="home-section-heading"><text class="home-section-number">01</text><view class="home-section-titles"><view class="home-section-english">EXPLORE THE PARK</view><view class="home-section-title">琴音之旅</view></view></view>
      <view class="home-section-note">在这里，遇见琴的诞生</view>
      <view class="home-explore-visual">
        <image class="home-explore-image" src="{{spots[0].images[1] || spots[0].cover}}" mode="aspectFill"/>
        <view class="home-explore-shade"/>
        <view class="home-explore-note">城市客厅·音乐生态湖·产业园·绿岛</view>
        <view class="home-guide-link" data-page="tour" bindtap="open" hover-class="home-pressed">进入探索<text class="home-arrow">›</text></view>
      </view>
    </view>
    <view class="home-section home-recommended" wx:if="{{packages.length}}">
      <view class="home-section-heading"><text class="home-section-number">02</text><view class="home-section-titles"><view class="home-section-english">RECOMMENDED</view><view class="home-section-title">热门推荐</view></view><view class="home-view-all" data-page="study" bindtap="tab" hover-class="home-pressed">查看全部<text class="home-arrow">›</text></view></view>
      <view class="home-section-note">初次到访，从这两条路线开始</view>
      <view class="home-packages">
        <view class="home-package" wx:for="{{packages}}" wx:key="id" data-page="package" data-id="{{item.id}}" bindtap="open" hover-class="home-pressed">
          <image class="home-package-image" src="{{item.cover}}" mode="aspectFill"/>
          <view class="home-package-shade"/>
          <view class="home-package-body"><view class="home-item-title">{{item.name}}</view><view class="home-item-note">{{item.durationNote}}</view><view class="home-package-price" wx:if="{{item.referenceSinglePrice || item.referenceSinglePrice === 0}}">单人参考价 <text class="home-price-value">¥{{item.referenceSinglePrice}}</text></view><view class="home-package-price" wx:else>费用请咨询</view></view>
        </view>
      </view>
    </view>
    <view class="home-footer">
      <view class="home-footer-brand">黄桥乐器文化产业园</view>
      <view class="home-notice" wx:if="{{site.notice}}">{{site.notice}}</view>
      <button class="home-about" data-page="about" bindtap="open" hover-class="home-pressed">关于我们与服务说明<text class="home-arrow">→</text></button>
    </view>
  </block>
</view>
