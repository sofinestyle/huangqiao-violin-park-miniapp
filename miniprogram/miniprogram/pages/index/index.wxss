@import "../../styles/design-tokens.wxss";

.home { background: var(--home-bg); color: var(--home-text); font-family: var(--home-sans); line-height: 1.7; }
.home-brand { display: flex; align-items: center; gap: 28rpx; padding: 32rpx var(--home-gutter); background: var(--home-surface); }
.home-logo { flex-shrink: 0; width: 128rpx; height: 80rpx; background: var(--home-walnut); border-radius: 6rpx; }
.home-brand-name { font-family: var(--home-serif); font-size: 34rpx; font-weight: 600; line-height: 1.4; }
.home-hero { position: relative; height: 700rpx; min-height: 298px; overflow: hidden; background: var(--home-walnut); }
.home-hero-image { display: block; width: 100%; height: 100%; }
.home-hero-shade { position: absolute; inset: 0; background: linear-gradient(110deg, rgba(20,12,8,.72), rgba(20,12,8,.2) 40%, rgba(20,12,8,0) 65%); pointer-events: none; }
.home-hero-caption { position: absolute; top: 38rpx; left: var(--home-gutter); right: var(--home-gutter); color: var(--home-surface); }
.home-hero-title { font-family: var(--home-serif); font-size: 56rpx; font-weight: 600; line-height: 1.3; }
.home-hero-subtitle { margin-top: 8rpx; }
.home-hero-rule { width: 52rpx; height: 2rpx; margin: 24rpx 0; background: var(--home-gold); }
.home-hero-note { font-size: 26rpx; line-height: 1.65; }
.home-hero-action { display: inline-flex; align-items: center; justify-content: space-between; min-height: 44px; min-width: 44px; margin-top: 24rpx; padding: 12rpx 24rpx; background: var(--home-surface); color: var(--home-walnut); border-radius: 48rpx; font-size: 28rpx; font-weight: 500; line-height: 1.5; }
.home-arrow { margin-left: 16rpx; font-family: var(--home-sans); font-size: 30rpx; line-height: 1.4; }
.home-services { position: relative; padding: 28rpx var(--home-gutter) 0; background: var(--home-bg); }
.home-service-primary { display: grid; grid-template-columns: 1fr 1.2fr; gap: 20rpx; }
.home-entry { min-width: 0; min-height: 44px; }
.home-service-primary .home-entry { position: relative; height: 244rpx; overflow: hidden; border-radius: 8rpx; background: var(--home-walnut); color: var(--home-surface); }
.home-service-primary .home-service-image { display: block; width: 100%; height: 100%; }
.home-entry-caption { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: flex-end; padding: 16rpx 20rpx; background: linear-gradient(0deg,rgba(28,18,12,.9),rgba(28,18,12,0) 75%); }
.home-entry-title { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; font-family: var(--home-serif); font-size: 30rpx; font-weight: 600; line-height: 1.45; }
.home-entry-arrow { flex-shrink: 0; font-family: var(--home-sans); font-size: 28rpx; font-weight: 400; }
.home-entry-note { margin-top: 4rpx; font-size: 26rpx; line-height: 1.6; }
.home-service-secondary { display: grid; grid-template-columns: 1fr 1fr; gap: 24rpx; padding: 24rpx 0; }
.home-entry-small { display: flex; align-items: center; gap: 12rpx; }
.home-entry-small .home-service-image { width: 76rpx; height: 96rpx; flex-shrink: 0; border-radius: 4rpx; }
.home-entry-copy { flex: 1; min-width: 0; }
.home-entry-small .home-entry-title { font-size: 28rpx; }
.home-entry-small .home-entry-note { color: var(--home-secondary); font-size: 26rpx; }
.home-service-support { display: flex; gap: 32rpx; border-top: 1rpx solid var(--home-line); border-bottom: 1rpx solid var(--home-line); }
.home-service-support .home-entry { display: flex; align-items: center; justify-content: space-between; flex: 1; padding: 14rpx 0; font-size: 28rpx; }
.home-story { margin: 40rpx var(--home-gutter) 48rpx; }
.home-story-heading { font-family: var(--home-serif); font-size: 34rpx; font-weight: 600; line-height: 1.4; }
.home-story-intro { margin-top: 16rpx; font-size: 30rpx; line-height: 1.7; color: var(--home-secondary); }
.home-section { margin: 48rpx var(--home-gutter); }
.home-explore-visual { position: relative; height: 468rpx; min-height: 220px; border-radius: 16rpx; overflow: hidden; background: var(--home-walnut); color: var(--home-surface); }
.home-explore-image { display: block; width: 100%; height: 100%; }
.home-explore-shade { position: absolute; inset: 0; background: linear-gradient(0deg,rgba(16,21,16,.85),rgba(16,21,16,.05) 55%,rgba(16,21,16,.72)); pointer-events: none; }
.home-section-heading { display: flex; align-items: center; gap: 20rpx; }
.home-section-number { flex-shrink: 0; font-family: var(--home-serif); font-size: 72rpx; color: var(--home-gold-text); font-weight: 400; line-height: 1.1; }
.home-section-titles { flex: 1; min-width: 0; }
.home-section-english { font-family: var(--home-serif); font-size: 24rpx; letter-spacing: 2rpx; line-height: 1.5; }
.home-section-title { font-family: var(--home-serif); font-size: 40rpx; font-weight: 600; line-height: 1.35; }
.home-explore-visual .home-section-heading { position: absolute; top: 28rpx; left: 28rpx; right: 28rpx; }
.home-explore-visual .home-section-number { color: var(--home-surface); }
.home-explore-visual .home-section-title { font-size: 34rpx; }
.home-explore-caption { position: absolute; bottom: 28rpx; left: 28rpx; right: 28rpx; }
.home-explore-note { font-size: 26rpx; line-height: 1.6; }
.home-guide-link { display: inline-flex; align-items: center; justify-content: space-between; min-height: 44px; min-width: 44px; margin-top: 12rpx; padding: 8rpx 20rpx; border-radius: 44rpx; background: var(--home-surface); color: var(--home-walnut); font-size: 28rpx; line-height: 1.5; }
.home-spots { display: grid; grid-template-columns: 1fr 1fr; gap: 8rpx 24rpx; margin-top: 20rpx; }
.home-spot { display: flex; align-items: center; gap: 12rpx; min-height: 44px; padding: 8rpx 0; }
.home-spot-image { flex-shrink: 0; width: 64rpx; height: 64rpx; border-radius: 4rpx; }
.home-spot-name { flex: 1; min-width: 0; font-size: 28rpx; line-height: 1.5; }
.home-spot-arrow { font-size: 26rpx; flex-shrink: 0; }
.home-recommended .home-section-english { color: var(--home-secondary); }
.home-section-note { margin-top: 12rpx; color: var(--home-secondary); font-size: 26rpx; line-height: 1.6; }
.home-packages { display: grid; grid-template-columns: 1fr 1fr; gap: 24rpx; margin-top: 24rpx; }
.home-package { min-width: 0; background: var(--home-surface); border-radius: 12rpx; overflow: hidden; }
.home-package-image { display: block; width: 100%; height: 238rpx; background: var(--home-line); }
.home-package-body { padding: 16rpx 20rpx 8rpx; }
.home-item-title { font-family: var(--home-serif); font-size: 32rpx; font-weight: 600; line-height: 1.45; }
.home-item-note { margin-top: 8rpx; color: var(--home-secondary); font-size: 26rpx; line-height: 1.6; }
.home-package-meta { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 8rpx; }
.home-package-meta .home-item-note { margin: 0; }
.home-package-detail { display: flex; align-items: center; justify-content: space-between; min-height: 44px; font-size: 26rpx; line-height: 1.5; }
.home-package-detail .home-arrow { margin-left: 8rpx; }
.home-footer { padding: 48rpx var(--home-gutter) 44rpx; background: var(--home-walnut); color: var(--home-surface); }
.home-footer-brand { font-family: var(--home-serif); font-size: 34rpx; font-weight: 600; line-height: 1.4; }
.home-notice { margin-top: 16rpx; font-size: 26rpx; line-height: 1.8; }
.home .home-about { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 44px; margin: 24rpx 0 0; padding: 12rpx 0; background: transparent; color: var(--home-surface); border: 0; border-top: 1rpx solid rgba(255,253,247,.25); border-radius: 0; font-size: 28rpx; font-weight: 500; line-height: 1.5; text-align: left; }
.home-about::after { border: 0; }
.home .loading, .home .error { margin: 32rpx var(--home-gutter); padding: 32rpx; background: var(--home-surface); color: var(--home-secondary); border-radius: 8rpx; font-size: 30rpx; line-height: 1.7; }
.home .error { color: var(--home-error); }
.home .error button { min-height: 44px; margin-top: 24rpx; padding: 16rpx 24rpx; background: var(--home-walnut); color: var(--home-surface); border: 0; border-radius: 16rpx; font-size: 28rpx; line-height: 1.5; }
.home .error button::after { border: 0; }
.home-pressed { opacity: .72; }

@media (max-width: 340px) {
  .home-brand { gap: 20rpx; padding-top: 30rpx; padding-bottom: 30rpx; }
  .home-brand-name { font-size: 32rpx; }
  .home-service-secondary { gap: 20rpx; }
  .home-entry-small { flex-wrap: wrap; gap: 8rpx; }
  .home-entry-small .home-service-image { width: 76rpx; height: 76rpx; }
  .home-entry-small .home-entry-copy { flex-basis: 170rpx; }
  .home-entry-small > .home-entry-arrow { display: none; }
  .home-explore-visual .home-section-heading { gap: 12rpx; }
  .home-explore-visual .home-section-title { font-size: 34rpx; }
  .home-packages { gap: 24rpx; }
}
