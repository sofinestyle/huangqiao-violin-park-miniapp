@import "../../styles/design-tokens.wxss";

.home { padding-bottom: calc(52px + env(safe-area-inset-bottom)); background: var(--home-bg); color: var(--home-text); font-family: var(--home-sans); line-height: 1.7; }
.home-brand { position: sticky; top: 0; z-index: 10; display: flex; align-items: center; gap: 24rpx; box-sizing: border-box; height: 55px; padding: 0 var(--home-gutter); background: rgba(60,43,36,.9); }
.home-logo { flex-shrink: 0; width: 139.2rpx; height: 86.4rpx; background: transparent; border-radius: 4rpx; }
.home-brand-name { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); white-space: nowrap; text-align: center; color: #FFFFFF; font-family: "Microsoft YaHei", "微软雅黑", "PingFang SC", sans-serif; font-size: 34rpx; font-weight: 500; line-height: 1.4; letter-spacing: 1rpx; }
.home-hero { position: relative; height: 940rpx; min-height: 410px; overflow: visible; background: var(--home-walnut); }
.home-hero-media { position: absolute; top: -55px; left: 0; right: 0; height: calc(100% + 55px); overflow: hidden; background: var(--home-walnut); }
.home-hero-image { position: absolute; right: 0; top: 0; display: block; width: calc(1000rpx + 60px); height: 100%; }
.home .loading ~ .home-hero .home-hero-media, .home .error ~ .home-hero .home-hero-media { top: 0; height: 100%; }
.home .loading ~ .home-hero .home-hero-image, .home .error ~ .home-hero .home-hero-image { width: 1000rpx; }
.home-hero-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(20,12,8,0) 28%, rgba(20,12,8,.54) 48%, rgba(20,12,8,.94) 100%); pointer-events: none; }
.home-hero-caption { position: absolute; bottom: calc(44rpx + 20px); left: var(--home-gutter); right: var(--home-gutter); color: var(--home-surface); }
.home-hero-title { font-family: var(--home-serif); font-size: 60rpx; font-weight: 900; line-height: 1.25; }
.home-hero-subtitle { margin-top: 0; color: #E2C88F; }
.home-hero-note { margin-top: 24rpx; color: #F4ECDD; font-size: 28rpx; line-height: 1.8; text-indent: 2em; }
.home-content { position: relative; z-index: 1; margin-top: -16px; padding-top: 16px; border-radius: 24px 24px 0 0; background: var(--home-bg); }
.home-quick-nav { display: flex; box-sizing: border-box; margin: 16px var(--home-gutter) 0; padding: 10px 4px; border: 1px solid #E5D5B8; border-radius: 16px; background: #FBF8F0; }
.home-nav-item { flex: 1; min-width: 0; min-height: 82px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; }
.home-nav-icon { display: block; width: 48px; height: 48px; border-radius: 12px; }
.home-nav-label { white-space: nowrap; color: var(--home-walnut); font-size: 14px; font-weight: 500; line-height: 1.5; }
.home-arrow { margin-left: 16rpx; font-family: var(--home-sans); font-size: 30rpx; line-height: 1.4; }
.home-section { margin: 48rpx var(--home-gutter); }
.home-explore-visual { position: relative; height: 468rpx; min-height: 220px; margin-top: 24rpx; border-radius: 48rpx; overflow: hidden; background: var(--home-walnut); color: var(--home-surface); }
.home-explore-image { display: block; width: 100%; height: 100%; }
.home-explore-shade { position: absolute; inset: 0; background: linear-gradient(0deg,rgba(28,21,17,.82),rgba(28,21,17,.03) 55%,rgba(28,21,17,.68)), rgba(185,154,104,.07); pointer-events: none; }
.home-section-heading { display: flex; align-items: center; gap: 20rpx; }
.home-section-number { flex-shrink: 0; font-family: var(--home-serif); font-size: 72rpx; color: var(--home-gold-text); font-weight: 400; line-height: 1.1; }
.home-section-titles { flex: 1; min-width: 0; }
.home-section-english { font-family: var(--home-serif); font-size: 24rpx; letter-spacing: 1.5rpx; line-height: 1.5; }
.home-section-title { font-family: var(--home-serif); font-size: 40rpx; font-weight: 600; line-height: 1.35; }
.home-explore-note { position: absolute; top: calc(28rpx + 20px); left: 28rpx; right: 28rpx; color: #E2C88F; font-family: "Microsoft YaHei", "微软雅黑", "PingFang SC", sans-serif; font-size: 26rpx; font-weight: 500; line-height: 1.6; }
.home-guide-link { position: absolute; bottom: 28rpx; right: 28rpx; display: inline-flex; align-items: center; justify-content: space-between; min-height: 44px; min-width: 44px; padding: 8rpx 32rpx; border-radius: 999px; background: #E2C88F; color: var(--home-walnut); font-size: 28rpx; line-height: 1.5; }
.home-section-english { color: var(--home-secondary); }
.home-section-note { margin-top: 12rpx; color: var(--home-secondary); font-size: 26rpx; line-height: 1.6; }
.home-packages { display: grid; grid-template-columns: 1fr 1fr; gap: 24rpx; margin-top: 24rpx; }
.home-view-all { display: flex; align-items: center; justify-content: flex-end; flex-shrink: 0; min-height: 44px; min-width: 44px; color: var(--home-secondary); font-size: 26rpx; white-space: nowrap; }
.home-view-all .home-arrow { margin-left: 8rpx; }
.home-package { position: relative; min-width: 0; height: 0; padding-top: 100%; overflow: hidden; border-radius: 48rpx; background: var(--home-walnut); }
.home-package-image { position: absolute; top: 0; left: 0; display: block; width: 100%; height: 100%; }
.home-package-shade { position: absolute; inset: 0; background: linear-gradient(180deg,rgba(20,12,8,0) 10%,rgba(20,12,8,.52) 42%,rgba(20,12,8,.94) 100%); pointer-events: none; }
.home-package-body { position: absolute; left: 20rpx; right: 20rpx; bottom: 16rpx; color: var(--home-surface); }
.home-item-title { font-family: var(--home-serif); font-size: 32rpx; font-weight: 700; line-height: 1.35; }
.home-item-note { margin-top: 6rpx; color: #F4ECDD; font-size: 24rpx; line-height: 1.5; }
.home-package-price { margin-top: 6rpx; color: #E2C88F; font-size: 24rpx; line-height: 1.5; }
.home-price-value { font-size: 32rpx; font-weight: 700; }
.home-summary { display: flex; align-items: center; padding: 30px var(--home-gutter); border-radius: 24px 24px 0 0; background: var(--home-walnut); color: #E2C88F; }
.home-summary-item { flex: 1; display: flex; align-items: center; justify-content: center; gap: 8rpx; min-height: 60px; min-width: 0; }
.home-summary-item + .home-summary-item { border-left: 1px solid rgba(226,200,143,.18); }
.home-summary-item image { flex-shrink: 0; width: 48rpx; height: 48rpx; }
.home-summary-value { color: #FFFDF7; font-family: var(--home-serif); font-size: 48rpx; line-height: 1.15; }
.home-summary-value text { margin-left: 8rpx; font-size: 24rpx; }
.home-summary-label { margin-top: 6rpx; color: #E4D9C9; font-size: 12px; line-height: 1.5; }
.home .loading, .home .error { margin: 32rpx var(--home-gutter); padding: 32rpx; background: var(--home-surface); color: var(--home-secondary); border-radius: 8rpx; font-size: 30rpx; line-height: 1.7; }
.home .error { color: var(--home-error); }
.home .error button { min-height: 44px; margin-top: 24rpx; padding: 16rpx 24rpx; background: var(--home-walnut); color: var(--home-surface); border: 0; border-radius: 16rpx; font-size: 28rpx; line-height: 1.5; }
.home .error button::after { border: 0; }
.home-pressed { opacity: .72; }

@media (max-width: 340px) {
  .home-brand { gap: 20rpx; }
  .home-brand-name { font-size: 32rpx; }
  .home-quick-nav { margin-left: 12px; margin-right: 12px; }
  .home-nav-icon { width: 44px; height: 44px; }
  .home-nav-label { font-size: 13px; }
  .home-packages { gap: 24rpx; }
}
