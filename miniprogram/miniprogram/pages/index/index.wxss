@import "../../styles/design-tokens.wxss";

.home { background: var(--home-bg); color: var(--home-text); font-family: var(--home-sans); line-height: 1.7; }
.home-brand { display: flex; align-items: center; gap: 24rpx; padding: 24rpx var(--home-gutter); background: var(--home-surface); }
.home-logo { flex-shrink: 0; width: 112rpx; height: 68rpx; background: var(--home-walnut); border-radius: 8rpx; }
.home-brand-name { font-family: var(--home-serif); font-size: 32rpx; font-weight: 600; line-height: 1.35; }
.home-hero { position: relative; height: 760rpx; overflow: hidden; background: var(--home-walnut); }
.home-hero-image { display: block; width: 100%; height: 100%; }
.home-hero-shade { position: absolute; inset: 0; background: linear-gradient(140deg, rgba(20,12,8,0.6), rgba(20,12,8,0) 54%); pointer-events: none; }
.home-hero-caption { position: absolute; top: 48rpx; left: var(--home-gutter); right: var(--home-gutter); pointer-events: none; }
.home-hero-title { color: var(--home-surface); font-family: var(--home-serif); font-size: 56rpx; font-weight: 600; line-height: 1.32; }
.home-hero-subtitle { margin-top: 12rpx; }
.home-hero-rule { width: 56rpx; height: 2rpx; margin-top: 32rpx; background: var(--home-gold); }
.home-hero-action { display: flex; align-items: center; justify-content: space-between; min-height: 44px; padding: 16rpx var(--home-gutter); box-sizing: border-box; background: var(--home-walnut); color: var(--home-surface); font-size: 28rpx; font-weight: 500; }
.home-arrow { margin-left: 16rpx; font-family: var(--home-sans); font-size: 32rpx; line-height: 1.4; }
.home-services { padding: 16rpx var(--home-gutter) 0; }
.home-service-group { display: flex; align-items: center; gap: 24rpx; padding: 24rpx 0; border-bottom: 1rpx solid var(--home-line); }
.home-service-label { flex: 0 0 56rpx; white-space: nowrap; color: var(--home-gold-text); font-size: 24rpx; line-height: 1.6; }
.home-service-pair { display: flex; gap: 24rpx; flex: 1; min-width: 0; }
.home-entry { flex: 1; min-width: 0; min-height: 44px; padding: 8rpx 0; }
.home-entry-title { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; font-size: 28rpx; font-weight: 500; line-height: 1.5; }
.home-entry-featured .home-entry-title { font-family: var(--home-serif); font-size: 32rpx; font-weight: 600; }
.home-entry-arrow { flex-shrink: 0; font-family: var(--home-sans); font-size: 28rpx; font-weight: 400; }
.home-entry-note { margin-top: 8rpx; color: var(--home-secondary); font-size: 26rpx; line-height: 1.6; }
.home-story { margin: var(--home-section-gap) var(--home-gutter); padding-left: 24rpx; border-left: 2rpx solid var(--home-gold); }
.home-story-heading { margin-bottom: 16rpx; font-family: var(--home-serif); font-size: 38rpx; font-weight: 600; line-height: 1.35; }
.home-story-intro { font-size: 30rpx; line-height: 1.8; }
.home-section { margin: var(--home-section-gap) var(--home-gutter); }
.home-section-heading { display: flex; align-items: center; gap: 24rpx; }
.home-section-number { flex-shrink: 0; font-family: var(--home-serif); font-size: 76rpx; color: var(--home-gold-text); font-weight: 400; line-height: 1.15; }
.home-section-titles { flex: 1; min-width: 0; }
.home-section-english { color: var(--home-secondary); font-family: var(--home-serif); font-size: 24rpx; letter-spacing: 2rpx; line-height: 1.5; }
.home-section-title { font-family: var(--home-serif); font-size: 40rpx; font-weight: 600; line-height: 1.35; }
.home-guide-link { display: flex; align-items: center; justify-content: center; flex-shrink: 0; min-height: 44px; min-width: 44px; font-size: 26rpx; line-height: 1.5; }
.home-guide-link .home-arrow { margin-left: 8rpx; }
.home-section-note { margin-top: 16rpx; color: var(--home-secondary); font-size: 26rpx; line-height: 1.6; }
.home-spots { margin-top: 24rpx; }
.home-spot { position: relative; display: flex; align-items: center; gap: 24rpx; padding: 24rpx 0; border-bottom: 1rpx solid var(--home-line); }
.home-spot-image { flex-shrink: 0; width: 200rpx; height: 150rpx; border-radius: 8rpx; background: var(--home-line); }
.home-spot-copy { flex: 1; min-width: 0; }
.home-item-title { font-family: var(--home-serif); font-size: 32rpx; font-weight: 600; line-height: 1.45; }
.home-item-note { margin-top: 8rpx; color: var(--home-secondary); font-size: 26rpx; line-height: 1.6; }
.home-spot-arrow { flex-shrink: 0; margin-left: 0; }
.home-spot:first-child { display: block; padding: 0 0 24rpx; }
.home-spot:first-child .home-spot-image { display: block; width: 100%; height: 432rpx; border-radius: 8rpx; }
.home-spot:first-child .home-spot-copy { padding-top: 24rpx; padding-right: 56rpx; }
.home-spot:first-child .home-spot-arrow { position: absolute; right: 0; bottom: 32rpx; }
.home-package { margin-top: 32rpx; padding-bottom: 32rpx; border-bottom: 1rpx solid var(--home-line); }
.home-package-image { display: block; width: 100%; height: 386rpx; border-radius: 16rpx; background: var(--home-line); }
.home-package-body { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; padding-top: 24rpx; }
.home-package-copy { flex: 1; min-width: 0; }
.home-package-detail { display: flex; align-items: center; flex-shrink: 0; min-height: 44px; font-size: 26rpx; line-height: 1.5; }
.home-package-detail .home-arrow { margin-left: 8rpx; }
.home-footer { padding: 40rpx var(--home-gutter) 48rpx; background: var(--home-walnut); color: var(--home-surface); }
.home-notice { font-size: 26rpx; line-height: 1.8; }
.home .home-about { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 44px; margin: 24rpx 0 0; padding: 16rpx 0; background: transparent; color: var(--home-surface); border: 0; border-top: 1rpx solid rgba(255,253,247,0.25); border-radius: 0; font-size: 28rpx; font-weight: 500; line-height: 1.5; text-align: left; }
.home-about::after { border: 0; }
.home .loading, .home .error { margin: 32rpx var(--home-gutter); padding: 32rpx; background: var(--home-surface); color: var(--home-secondary); border-radius: 8rpx; font-size: 30rpx; line-height: 1.7; }
.home .error { color: var(--home-error); }
.home .error button { min-height: 44px; margin-top: 24rpx; padding: 16rpx 24rpx; background: var(--home-walnut); color: var(--home-surface); border: 0; border-radius: 16rpx; font-size: 28rpx; line-height: 1.5; }
.home .error button::after { border: 0; }
.home-pressed { opacity: 0.68; }
.home-pressed-dark { background-color: #503A2F; }

@media (max-width: 340px) {
  .home-brand { gap: 16rpx; }
  .home-brand-name { font-size: 30rpx; }
  .home-service-group { gap: 16rpx; }
  .home-service-pair { gap: 24rpx; }
  .home-section-heading { gap: 16rpx; flex-wrap: wrap; }
  .home-guide-link { margin-left: auto; }
  .home-spot-image { width: 176rpx; height: 144rpx; }
  .home-package-body { gap: 16rpx; }
}
