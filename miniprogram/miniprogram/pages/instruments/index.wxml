<import src="../../templates/state.wxml"/><view class="page"><view class="h1">{{title}}</view><view class="muted">查看产品与规格，留下您的需求。</view><input class="search" placeholder="搜索名称或产品编码" value="{{q}}" bindinput="search"/><scroll-view scroll-x class="filters"><view wx:for="{{filters}}" wx:key="*this" class="filter {{selected===item?'on':''}}" data-filter="{{item}}" bindtap="select">{{item}}</view></scroll-view><template is="state" data="{{loading,error}}"/><view class="grid" wx:if="{{!loading}}"><view class="card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><image class="cover" src="{{item.cover}}" mode="aspectFill"/><view class="card-body"><view class="tag">{{item.categoryLabel}}</view><view class="h3">{{item.name}}</view><view class="price">{{item.priceLabel}}</view><button class="text-button" data-id="{{item.id}}" catchtap="open">查看详情</button></view></view></view><view wx:if="{{!loading && !error && !items.length}}" class="empty">暂无符合条件的产品</view></view>
