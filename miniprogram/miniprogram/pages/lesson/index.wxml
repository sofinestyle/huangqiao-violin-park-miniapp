<import src="../../templates/state.wxml"/><view class="page"><template is="state" data="{{loading,error}}"/><block wx:if="{{item}}"><view class="h1">{{item.name}}</view><view class="muted">{{item.category}}</view><video wx:if="{{item.type==='video' && !playbackError}}" id="teaching-video" src="{{item.videoUrl}}" poster="{{item.cover}}" controls autoplay="{{false}}" show-fullscreen-btn="{{true}}" binderror="playError" bindtimeupdate="time" bindended="ended" bindplay="play" bindpause="pause"/><view wx:if="{{playbackError}}" class="error">视频加载失败，请重试。<button class="secondary" bindtap="retry">重新加载视频</button></view><image wx:if="{{item.type!=='video' && item.cover}}" class="cover" src="{{item.cover}}" mode="aspectFill"/><view class="h2">内容介绍</view><view class="intro pre-line">{{item.description}}</view><view wx:if="{{item.type==='course'}}" class="panel"><view>适合对象：{{item.audience}}</view><view>授课形式：{{item.form}}</view><view>地点：{{item.place}}</view><view>时间：{{item.courseTime}}</view><view>费用说明：{{item.courseFee}}</view></view><button bindtap="consult">咨询相关教学与课程</button><view class="support-note">观看视频不代表课程报名。</view></block></view>
