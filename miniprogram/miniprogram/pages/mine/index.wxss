/* Local menu styling follows the user reference; all existing actions are retained. */
.mine-shell { min-height: 100vh; background: #f4ecdd; color: #38291c; }
.mine-brand { position: sticky; top: 0; z-index: 10; display: flex; align-items: center; height: 55px; padding: 0 40rpx; background: #3c2b24; }
.mine-brand-logo { flex-shrink: 0; width: 139.2rpx; height: 86.4rpx; background: transparent; border-radius: 4rpx; }
.mine-brand-title { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); white-space: nowrap; text-align: center; color: #fff; font-family: "Microsoft YaHei", "微软雅黑", "PingFang SC", sans-serif; font-size: 34rpx; font-weight: 500; line-height: 1.4; letter-spacing: 1rpx; }
.mine-page { padding: 32rpx 28rpx calc(40rpx + 52px + env(safe-area-inset-bottom)); }
.mine-identity { padding: 0 12rpx 28rpx; }
.mine-identity-title { font-size: 28rpx; font-weight: 500; line-height: 1.5; margin-bottom: 8rpx; }
.mine-identity-note { color: #75634f; font-size: 24rpx; line-height: 1.8; }
.mine-page .mine-login { margin-top: 20rpx; min-height: 44px; background: #4b3325; border-radius: 14rpx; }
.mine-page .mine-login[disabled] { background: #c2b3a1; }
.mine-group { background: #fbf7ee; border: 1px solid #e3d2af; border-radius: 26rpx; overflow: hidden; margin-bottom: 28rpx; }
.mine-row { display: flex; align-items: center; gap: 22rpx; min-height: 114rpx; padding: 23rpx 28rpx; }
.mine-row + .mine-row { border-top: 1px solid #e0d2b7; }
.mine-row-pressed { background: #f1e6d3; }
.mine-icon-box { flex: 0 0 62rpx; width: 62rpx; height: 62rpx; display: flex; align-items: center; justify-content: center; background: #f3ecdf; border-radius: 17rpx; }
.mine-icon { width: 32rpx; height: 32rpx; background-size: contain; background-repeat: no-repeat; background-position: center; }
.mine-row-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 3rpx; }
.mine-row-title { font-size: 29rpx; font-weight: 500; line-height: 1.5; }
.mine-row-note { color: #796952; font-size: 22rpx; line-height: 1.4; }
.mine-arrow { flex: 0 0 14rpx; color: #b88a39; font-size: 36rpx; line-height: 1; text-align: right; }
@media (max-width: 320px) { .mine-row { padding-left: 24rpx; padding-right: 24rpx; min-height: 60px; } }
