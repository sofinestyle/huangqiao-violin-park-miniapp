<import src="../../templates/state.wxml"/>
<view class="visitor-page">
  <view class="visitor-brand">
    <image class="visitor-logo" src="/assets/yorray-logo.png" mode="aspectFit" aria-label="YorRay"/>
    <text class="visitor-brand-name">套餐详情</text>
  </view>
  <view class="page"><template is="state" data="{{loading,error}}"/><block wx:if="{{item}}"><image class="cover" src="{{item.cover}}" mode="aspectFill" binderror="imageError"/><view class="h1">{{item.name}}</view><view class="muted">{{item.ageNote}} · {{item.durationNote}}</view><view class="panel"><view class="muted">具体费用与接待安排请咨询工作人员。</view></view><view class="h2">行程与参加说明</view><view class="intro pre-line">{{item.itinerary}}</view><view class="panel"><view class="detail-line"><text class="key">包含说明</text><text>{{item.included}}</text></view><view class="detail-line"><text class="key">不含说明</text><text>{{item.excluded}}</text></view><view class="detail-line"><text class="key">作品 / 材料</text><text>{{item.materials}}</text></view><view class="detail-line"><text class="key">集合地点</text><text>{{item.meetingPoint}}</text></view><view class="detail-line"><text class="key">转场安排</text><text>{{item.transfer}}</text></view></view><view class="h2">预约说明</view><view class="intro">{{item.bookingNote}}</view><view class="h2">取消与改期</view><view class="intro">{{item.cancelNote}}</view><view class="sticky-action"><button bindtap="book">个人 / 家庭预约申请</button><view class="actions"><button class="secondary" bindtap="group">团体申请</button><button class="secondary" bindtap="consult">套餐咨询</button></view></view></block></view>
  <view class="park-tabs">
    <navigator class="park-tab" url="/pages/index/index" open-type="switchTab" hover-class="park-tab-pressed" aria-role="button" aria-label="首页">
      <image class="park-tab-icon" src="/assets/tab-icons/home-muted.png" mode="aspectFit"/>
      <text class="park-tab-label">首页</text><view class="park-tab-line"/>
    </navigator>
    <navigator class="park-tab" url="/pages/instruments/index" open-type="switchTab" hover-class="park-tab-pressed" aria-role="button" aria-label="乐器">
      <image class="park-tab-icon" src="/assets/tab-icons/instrument-muted.png" mode="aspectFit"/>
      <text class="park-tab-label">乐器</text><view class="park-tab-line"/>
    </navigator>
    <navigator class="park-tab" url="/pages/gifts/index" open-type="switchTab" hover-class="park-tab-pressed" aria-role="button" aria-label="文创">
      <image class="park-tab-icon" src="/assets/tab-icons/gift-muted.png" mode="aspectFit"/>
      <text class="park-tab-label">文创</text><view class="park-tab-line"/>
    </navigator>
    <navigator class="park-tab park-tab-selected" url="/pages/study/index" open-type="switchTab" hover-class="park-tab-pressed" aria-role="button" aria-label="研学">
      <image class="park-tab-icon" src="/assets/tab-icons/study-active.png" mode="aspectFit"/>
      <text class="park-tab-label">研学</text><view class="park-tab-line"/>
    </navigator>
    <navigator class="park-tab" url="/pages/mine/index" open-type="switchTab" hover-class="park-tab-pressed" aria-role="button" aria-label="我的">
      <image class="park-tab-icon" src="/assets/tab-icons/mine-muted.png" mode="aspectFit"/>
      <text class="park-tab-label">我的</text><view class="park-tab-line"/>
    </navigator>
  </view>

</view>
