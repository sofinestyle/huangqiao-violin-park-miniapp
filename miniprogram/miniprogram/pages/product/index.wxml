<import src="../../templates/state.wxml"/>
<view class="visitor-page">
  <view class="visitor-brand">
    <image class="visitor-logo" src="/assets/yorray-logo.png" mode="aspectFit" aria-label="YorRay"/>
    <text class="visitor-brand-name">产品详情</text>
  </view>
  <view class="page"><template is="state" data="{{loading,error}}"/><block wx:if="{{item}}"><view wx:if="{{galleryImages.length}}" class="product-gallery-square"><swiper class="gallery" indicator-dots current="{{galleryCurrent}}" bindchange="galleryChange"><swiper-item wx:for="{{galleryImages}}" wx:key="*this"><image src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="preview" binderror="imageError"/></swiper-item></swiper></view><view wx:if="{{!galleryImages.length}}" class="empty">暂无产品图片</view><view wx:if="{{imageError}}" class="image-error">图片加载失败，请重试或咨询工作人员</view><view class="h1">{{item.name}}</view><view class="muted">编码 {{item.code}} · {{item.categoryLabel}}<text wx:if="{{item.brand}}"> · {{item.brand}}</text></view><view class="price">{{priceLabel}}</view><view class="muted">{{item.priceNote}}</view><view wx:if="{{item.variantMode==='options'}}" class="sku-selection"><view class="sku-heading"><view class="h2">选择规格</view><button size="mini" class="sku-reset" bindtap="resetSelection">重新选择规格</button></view><view wx:for="{{optionGroups}}" wx:for-item="option" wx:key="id" class="sku-option"><view class="sku-option-name">{{option.name}}</view><view class="sku-values"><button wx:for="{{option.values}}" wx:for-item="value" wx:key="id" size="mini" class="sku-chip {{value.selected?'sku-chip-selected':''}}" disabled="{{value.disabled}}" aria-label="{{option.name}}：{{value.label}}{{value.selected?'，已选中':''}}{{value.disabled?'，暂不可选':''}}" data-option-id="{{option.id}}" data-value-id="{{value.id}}" bindtap="select">{{value.label}}<text wx:if="{{value.disabled}}" class="sku-unavailable-label">暂不可选</text></button></view></view><view wx:if="{{specLabel}}" class="sku-summary">已选：{{specLabel}}</view></view><view wx:if="{{skuNotice}}" class="sku-notice">{{skuNotice}}</view><view class="h2">产品介绍</view><view class="intro pre-line">{{item.description}}</view><view class="sticky-action"><button wx:if="{{phone}}" class="secondary" bindtap="phone">电话咨询</button><button bindtap="consult" disabled="{{!canConsult}}">咨询此产品</button><view class="support-note">首期提供展示与咨询，不支持线上购买。</view></view></block></view>
  <view class="park-tabs">
    <navigator class="park-tab" url="/pages/index/index" open-type="switchTab" hover-class="park-tab-pressed" aria-role="button" aria-label="首页">
      <image class="park-tab-icon" src="/assets/tab-icons/home-muted.png" mode="aspectFit"/>
      <text class="park-tab-label">首页</text><view class="park-tab-line"/>
    </navigator>
    <navigator class="park-tab {{item && item.category !== 'gift' ? 'park-tab-selected' : ''}}" url="/pages/instruments/index" open-type="switchTab" hover-class="park-tab-pressed" aria-role="button" aria-label="乐器">
      <image class="park-tab-icon" src="/assets/tab-icons/instrument-{{item && item.category !== 'gift' ? 'active' : 'muted'}}.png" mode="aspectFit"/>
      <text class="park-tab-label">乐器</text><view class="park-tab-line"/>
    </navigator>
    <navigator class="park-tab {{item && item.category === 'gift' ? 'park-tab-selected' : ''}}" url="/pages/gifts/index" open-type="switchTab" hover-class="park-tab-pressed" aria-role="button" aria-label="文创">
      <image class="park-tab-icon" src="/assets/tab-icons/gift-{{item && item.category === 'gift' ? 'active' : 'muted'}}.png" mode="aspectFit"/>
      <text class="park-tab-label">文创</text><view class="park-tab-line"/>
    </navigator>
    <navigator class="park-tab" url="/pages/study/index" open-type="switchTab" hover-class="park-tab-pressed" aria-role="button" aria-label="研学">
      <image class="park-tab-icon" src="/assets/tab-icons/study-muted.png" mode="aspectFit"/>
      <text class="park-tab-label">研学</text><view class="park-tab-line"/>
    </navigator>
    <navigator class="park-tab" url="/pages/mine/index" open-type="switchTab" hover-class="park-tab-pressed" aria-role="button" aria-label="我的">
      <image class="park-tab-icon" src="/assets/tab-icons/mine-muted.png" mode="aspectFit"/>
      <text class="park-tab-label">我的</text><view class="park-tab-line"/>
    </navigator>
  </view>

</view>
