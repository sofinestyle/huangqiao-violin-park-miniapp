<import src="../../templates/state.wxml"/><view class="page"><template is="state" data="{{loading,error}}"/><block wx:if="{{item}}"><swiper wx:if="{{galleryImages.length}}" class="gallery" indicator-dots><swiper-item wx:for="{{galleryImages}}" wx:key="*this"><image src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="preview" binderror="imageError"/></swiper-item></swiper><view wx:if="{{!galleryImages.length}}" class="empty">暂无产品图片</view><view wx:if="{{imageError}}" class="image-error">图片加载失败，请重试或咨询工作人员</view><view class="h1">{{item.name}}</view><view class="muted">编码 {{item.code}} · {{item.categoryLabel}}<text wx:if="{{item.brand}}"> · {{item.brand}}</text></view><view class="price">{{item.priceLabel}}</view><view class="muted">{{item.priceNote}}</view><view wx:if="{{item.specs.length}}" class="h2">展示规格</view><scroll-view scroll-x class="filters"><view wx:for="{{item.specs}}" wx:key="name" class="filter {{selectedSpec===index?'on':''}}" data-index="{{index}}" bindtap="select">{{item.name}}</view></scroll-view><view class="panel" wx:if="{{item.specs.length}}"><view class="pre-line">{{item.specs[selectedSpec].description}}</view><view class="price" wx:if="{{item.specs[selectedSpec].price!==undefined && item.specs[selectedSpec].price!==null}}">此规格参考价 ¥{{item.specs[selectedSpec].price}}</view></view><view class="h2">产品介绍</view><view class="intro pre-line">{{item.description}}</view><view class="sticky-action"><button wx:if="{{phone}}" class="secondary" bindtap="phone">电话咨询</button><button bindtap="consult">咨询此产品</button><view class="support-note">首期提供展示与咨询，不支持线上购买。</view></view></block></view>
