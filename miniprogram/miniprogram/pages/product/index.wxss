@import "../../custom-tab-bar/index.wxss";

/* Page-local brand shell: follows the accepted tour page without changing global styles. */
.visitor-page {
  min-height: 100vh;
  padding-bottom: calc(52px + env(safe-area-inset-bottom));
  background: #f5eddd;
  color: #403326;
}
.visitor-page .visitor-brand {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 24rpx;
  height: 55px;
  padding: 0 40rpx;
  background: rgba(60, 43, 36, 0.9);
}
.visitor-page .visitor-logo {
  flex-shrink: 0;
  width: 139.2rpx;
  height: 86.4rpx;
  background: transparent;
  border-radius: 4rpx;
}
.visitor-page .visitor-brand-name {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  white-space: nowrap;
  text-align: center;
  color: #fff;
  font-family: "Microsoft YaHei", "微软雅黑", "PingFang SC", sans-serif;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1.4;
  letter-spacing: 1rpx;
}
@media (max-width: 320px) {
  .visitor-page .visitor-brand { gap: 20rpx; }
  .visitor-page .visitor-brand-name { font-size: 32rpx; }
}

/* Keep existing consultation/booking actions above the five-tab navigation. */
.visitor-page .sticky-action {
  bottom: calc(52px + env(safe-area-inset-bottom));
  z-index: 9;
  background: #f5eddd;
  padding-bottom: 20rpx;
}

/* Square display viewport; original images and preview URLs are untouched. */
.visitor-page .product-gallery-square { position: relative; width: 100%; padding-top: 100%; margin-bottom: 5px; }
.visitor-page .gallery {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}
.visitor-page .gallery image { width: 100%; height: 100%; }

/* SKU-2: page-local touch controls; no global typography or navigation changes. */
.sku-selection { margin: 32rpx 0; }
.sku-heading { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.sku-heading .h2 { margin:0; }
.sku-heading .sku-reset { width:auto; background:transparent; color:#604736; font-size:24rpx; padding:8rpx; min-height:44px; margin:0; flex-shrink:0; display:flex; align-items:center; }
.sku-reset::after { border:0; }
.sku-option { margin-top:24rpx; }
.sku-option-name { font-family:-apple-system,"PingFang SC","Microsoft YaHei",sans-serif; font-size:28rpx; font-weight:600; margin-bottom:12rpx; overflow-wrap:anywhere; }
.sku-values { display:flex; flex-wrap:wrap; gap:12rpx; }
.sku-values .sku-chip { width:auto; flex:0 1 auto; display:inline-flex; flex-direction:column; align-items:center; justify-content:center; min-height:44px; min-width:88rpx; max-width:100%; margin:0; padding:12rpx 24rpx; background:#faf7f0; color:#403326; border:1px solid #b8a995; border-radius:8rpx; font-family:-apple-system,"PingFang SC","Microsoft YaHei",sans-serif; font-size:28rpx; line-height:1.4; white-space:normal; word-break:break-all; }
.sku-chip::after { border:0; }
.sku-values .sku-chip-selected { background:#49352b; color:#fff; border-color:#49352b; }
.sku-values .sku-chip[disabled] { background:#ebe6dc; color:#776e63; border-style:dashed; }
.sku-unavailable-label { display:block; font-size:22rpx; line-height:1.4; }
.sku-summary,.sku-notice { margin:24rpx 0; font-size:26rpx; line-height:1.6; color:#605144; }
.sku-notice { padding:20rpx; border-left:4rpx solid #a38c70; }
