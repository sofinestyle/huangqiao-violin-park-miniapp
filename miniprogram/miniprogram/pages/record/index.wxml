<import src="../../templates/state.wxml"/><view class="page"><template is="state" data="{{loading,error}}"/><block wx:if="{{row}}"><view class="h1">{{row.displayName}}</view><view class="record-id">{{row.id}}</view><view class="status">{{row.stateLabel}}</view><view wx:if="{{kind==='bookings' && row.state==='pending'}}" class="panel">预约申请已提交，工作人员确认后生效。</view><view class="panel"><view class="detail-line"><text class="key">联系人</text><text>{{row.request.contactName}}</text></view><view class="detail-line"><text class="key">联系电话</text><text>{{row.request.phone}}</text></view><block wx:if="{{kind==='bookings'}}"><view class="detail-line"><text class="key">意向日期</text><text>{{row.request.date}}</text></view><view class="detail-line"><text class="key">人数</text><text>{{row.headcount}}人</text></view><view wx:if="{{row.request.team}}">团队：{{row.request.team}}</view><view class="intro pre-line">{{row.request.note}}</view></block><block wx:else><view class="muted" wx:if="{{row.snapshot.spec}}">所选规格 {{row.snapshot.spec}}</view><view class="intro pre-line">{{row.request.message}}</view></block></view><view wx:if="{{row.request.enrollment}}" class="panel"><view class="h3">报名时活动信息</view><view>{{row.request.enrollment.title}}</view><view>套餐：{{row.request.enrollment.packageName}}</view><view>{{row.request.enrollment.date}} {{row.request.enrollment.start}}—{{row.request.enrollment.end}}</view><view class="intro pre-line">集合地点：{{row.request.enrollment.meetingPoint}}</view></view><view wx:if="{{row.confirmed}}" class="panel"><view class="h3">已确认安排</view><view>{{row.confirmed.date}} {{row.confirmed.start}}—{{row.confirmed.end}}</view><view>人数：{{row.confirmed.total}}</view><view class="intro pre-line">{{row.confirmed.arrangement}}</view></view><view wx:if="{{row.public_note}}" class="panel"><view class="h3">处理说明</view><view class="pre-line">{{row.public_note}}</view></view><view wx:for="{{row.changes}}" wx:key="id" class="panel"><view class="h3">{{item.type==='cancel'?'取消申请':'日期 / 人数变更申请'}}</view><view>{{item.state==='pending'?'待处理':item.state==='approved'?'已批准':'未批准'}}</view><view class="muted">{{item.data.reason}}</view><view wx:if="{{item.result.note}}">{{item.result.note}}</view></view><view class="actions" wx:if="{{kind==='bookings' && row.state==='pending'}}"><button class="secondary" data-type="cancel" bindtap="openChange">撤回待确认申请</button></view><view class="actions" wx:if="{{kind==='bookings' && row.state==='confirmed'}}"><button class="secondary" data-type="cancel" bindtap="openChange">申请取消</button><button class="secondary" data-type="reschedule" bindtap="openChange">申请改期 / 人数变更</button></view><view wx:if="{{changeOpen}}" class="panel"><view class="h3">{{row.state==='pending'?'撤回申请':changeType==='cancel'?'申请取消':'申请改期 / 人数变更'}}</view><view class="field"><text class="label">原因说明</text><textarea value="{{form.reason}}" data-key="reason" bindinput="input" maxlength="800"/></view><block wx:if="{{changeType==='reschedule'}}"><view class="field"><text class="label">新的意向日期</text><picker mode="date" start="{{minDate}}" value="{{form.date}}" bindchange="date"><view class="picker-value">{{form.date}}</view></picker></view><view class="pair" wx:if="{{!row.request.group}}"><view class="field"><text class="label">成人数</text><input type="number" value="{{form.adults}}" data-key="adults" bindinput="input"/></view><view class="field"><text class="label">儿童数</text><input type="number" value="{{form.children}}" data-key="children" bindinput="input"/></view></view><view wx:if="{{row.request.group}}" class="field"><text class="label">预计总人数</text><input type="number" value="{{form.total}}" data-key="total" bindinput="input"/></view></block><view class="muted">已确认安排在工作人员批准前保持不变。</view><view wx:if="{{actionError}}" class="error">{{actionError}}</view><view class="actions"><button bindtap="action" disabled="{{busy}}" loading="{{busy}}">提交申请</button><button class="secondary" bindtap="closeChange">关闭</button></view></view><button class="secondary" bindtap="contact">联系工作人员</button></block></view>
