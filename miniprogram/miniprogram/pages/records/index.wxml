<import src="../../templates/state.wxml"/><view class="page"><view class="h1">{{kind==='bookings'?'我的研学预约':'我的咨询'}}</view><view wx:if="{{!hasIdentity}}" class="panel"><view class="muted">请登录后查看您的申请和咨询记录。</view><button bindtap="login">登录并查看记录</button></view><template is="state" data="{{loading,error}}"/><view class="panel" wx:if="{{hasIdentity && !loading}}"><view class="record-row" wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view class="top"><text>{{item.displayName}}</text><text class="status">{{item.stateLabel}}</text></view><view class="muted" wx:if="{{item.specDisplay}}">{{item.specDisplay}}</view><view class="record-id">{{item.id}}</view><view class="muted" wx:if="{{kind==='bookings'}}">意向 {{item.request.date}} · {{item.headcount}}人</view><view class="muted">{{item.createdLabel}}</view></view><view wx:if="{{!rows.length && !error}}" class="empty">暂无本人记录</view></view><button class="secondary" wx:if="{{hasIdentity}}" bindtap="retry">刷新记录</button></view>
