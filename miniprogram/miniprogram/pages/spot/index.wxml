<import src="../../templates/state.wxml"/>
<view class="page spot-page">
  <template is="state" data="{{loading,error}}"/>
  <block wx:if="{{item}}">
    <swiper class="gallery spot-gallery" indicator-dots indicator-color="rgba(255,253,247,0.5)" indicator-active-color="#fffdf7">
      <swiper-item wx:for="{{item.images}}" wx:key="*this">
        <image src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="preview" binderror="imageError"/>
      </swiper-item>
    </swiper>
    <view wx:if="{{imageError}}" class="image-error">图片加载失败，可重新加载</view>
    <view class="spot-story">
      <view class="h1 spot-title">{{item.name}}</view>
      <view class="intro pre-line spot-description">{{item.description}}</view>
    </view>
    <view class="panel spot-visit">
      <view class="h3 spot-visit-title">开放与到访</view>
      <view class="spot-opening">{{item.opening}}</view>
      <view class="muted spot-visit-note">{{item.visitNote}}</view>
      <view wx:if="{{item.address}}" class="spot-address">地址：{{item.address}}</view>
    </view>
    <view class="spot-actions">
      <button wx:if="{{item.coordinateVerified}}" class="secondary spot-map" bindtap="map" hover-class="spot-secondary-pressed">查看已核实位置</button>
      <button class="spot-consult" bindtap="consult" hover-class="spot-primary-pressed">咨询到访安排</button>
    </view>
  </block>
</view>
