<import src="../../templates/state.wxml"/><view class="test-notice">点位及图片为测试资料</view><view class="page"><template is="state" data="{{loading,error}}"/><block wx:if="{{item}}"><swiper class="gallery" indicator-dots><swiper-item wx:for="{{item.images}}" wx:key="*this"><image src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="preview" binderror="imageError"/></swiper-item></swiper><view wx:if="{{imageError}}" class="image-error">图片加载失败，可重新加载</view><view class="h1">{{item.name}}</view><view class="intro pre-line">{{item.description}}</view><view class="panel"><view class="h3">开放与到访</view><view>{{item.opening}}</view><view class="muted">{{item.visitNote}}</view><view wx:if="{{item.address}}">地址：{{item.address}}</view></view><button wx:if="{{item.coordinateVerified}}" class="secondary" bindtap="map">查看已核实位置</button><button bindtap="consult">咨询到访安排</button></block></view>
