/* Approved visitor phase: preserve gallery geometry and existing actions. */
.spot-page {
  padding: 32rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  color: #3c2b24;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}
.spot-page .spot-gallery { height: 430rpx; border-radius: 16rpx; background: #e5dccb; }
.spot-page .spot-gallery image { display: block; width: 100%; height: 430rpx; }
.spot-page .spot-story { margin: 36rpx 0 40rpx; }
.spot-page .spot-title {
  margin: 0 0 24rpx;
  font-family: "Songti SC", STSong, "Noto Serif CJK SC", serif;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.5;
  overflow-wrap: break-word;
}
.spot-page .spot-description { font-size: 30rpx; line-height: 1.8; color: #3c2b24; overflow-wrap: break-word; }
.spot-page .spot-visit {
  margin: 0 0 32rpx;
  padding: 28rpx 0;
  border: 0;
  border-top: 1rpx solid #e5dccb;
  border-bottom: 1rpx solid #e5dccb;
  border-radius: 0;
  background: transparent;
}
.spot-page .spot-visit-title {
  margin: 0 0 20rpx;
  font-family: "Songti SC", STSong, "Noto Serif CJK SC", serif;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.5;
}
.spot-page .spot-opening { font-size: 30rpx; line-height: 1.8; }
.spot-page .spot-visit-note { margin-top: 16rpx; font-size: 26rpx; line-height: 1.8; color: #6c5948; }
.spot-page .spot-address { margin-top: 20rpx; font-size: 28rpx; line-height: 1.8; overflow-wrap: break-word; }
.spot-page .spot-actions { display: flex; flex-direction: column; gap: 20rpx; }
.spot-page .spot-actions button { width: 100%; min-height: 44px; padding: 22rpx 28rpx; border-radius: 16rpx; font-size: 28rpx; line-height: 1.6; }
.spot-page button.spot-consult { background: #3c2b24; color: #fffdf7; }
.spot-page button.spot-map { color: #3c2b24; border-color: #826742; }
.spot-page .spot-primary-pressed { opacity: 0.86; }
.spot-page .spot-secondary-pressed { background: #eee6d8; }
.spot-page .image-error { padding: 48rpx 24rpx; margin-top: 16rpx; border-radius: 12rpx; font-size: 26rpx; line-height: 1.8; color: #a13e35; }
.spot-page .loading, .spot-page .empty { padding: 64rpx 20rpx; font-size: 28rpx; line-height: 1.8; color: #6c5948; }
.spot-page .error { margin: 24rpx 0; padding: 28rpx; border: 0; border-radius: 12rpx; font-size: 28rpx; line-height: 1.8; color: #a13e35; }
.spot-page .error button.secondary { min-height: 44px; font-size: 28rpx; color: #3c2b24; border-color: #826742; }
