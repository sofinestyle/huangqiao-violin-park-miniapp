<import src="../../templates/state.wxml"/>
<view class="visitor-page"><view class="visitor-brand"><image class="visitor-logo" src="/assets/yorray-logo.png" mode="aspectFit" aria-label="YorRay"/><text class="visitor-brand-name">教学课堂</text></view>
<view class="page"><view class="intro">教学图文、公开视频与课程信息。</view><input class="search" placeholder="搜索教学内容" value="{{q}}" bindinput="search"/><scroll-view scroll-x class="filters"><view wx:for="{{filters}}" wx:key="*this" class="filter {{selected===item?'on':''}}" data-filter="{{item}}" bindtap="select">{{item}}</view></scroll-view><template is="state" data="{{loading,error}}"/><view class="card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><image class="cover" src="{{item.cover}}" mode="aspectFill"/><view class="card-body"><view class="tag">{{item.type==='video'?'公开视频':item.type==='course'?'课程信息':'图文教学'}}</view><view class="teaching-title-row"><view class="h3">{{item.name}}</view><text wx:if="{{item.type==='video' && item.durationLabel}}" class="teaching-duration">{{item.durationLabel}} 秒</text></view><view class="muted">{{item.category}}</view></view></view><view wx:if="{{!loading && !error && !items.length}}" class="empty">暂无内容，敬请期待。</view></view>
  <view class="park-tabs">
    <navigator class="park-tab" url="/pages/index/index" open-type="switchTab" hover-class="park-tab-pressed" aria-role="button" aria-label="首页">
      <image class="park-tab-icon" src="/assets/tab-icons/home-muted.png" mode="aspectFit"/>
      <text class="park-tab-label">首页</text><view class="park-tab-line"/>
    </navigator>
    <navigator class="park-tab " url="/pages/instruments/index" open-type="switchTab" hover-class="park-tab-pressed" aria-role="button" aria-label="乐器">
      <image class="park-tab-icon" src="/assets/tab-icons/instrument-muted.png" mode="aspectFit"/>
      <text class="park-tab-label">乐器</text><view class="park-tab-line"/>
    </navigator>
    <navigator class="park-tab " url="/pages/gifts/index" open-type="switchTab" hover-class="park-tab-pressed" aria-role="button" aria-label="文创">
      <image class="park-tab-icon" src="/assets/tab-icons/gift-muted.png" mode="aspectFit"/>
      <text class="park-tab-label">文创</text><view class="park-tab-line"/>
    </navigator>
    <navigator class="park-tab" url="/pages/study/index" open-type="switchTab" hover-class="park-tab-pressed" aria-role="button" aria-label="研学">
      <image class="park-tab-icon" src="/assets/tab-icons/study-muted.png" mode="aspectFit"/>
      <text class="park-tab-label">研学</text><view class="park-tab-line"/>
    </navigator>
    <navigator class="park-tab" url="/pages/mine/index" open-type="switchTab" hover-class="park-tab-pressed" aria-role="button" aria-label="我的">
      <image class="park-tab-icon" src="/assets/tab-icons/mine-muted.png" mode="aspectFit"/>
      <text class="park-tab-label">我的</text><view class="park-tab-line"/>
    </navigator>
  </view>

</view>
