<import src="../../templates/state.wxml"/><view class="page"><view class="h1">教学课堂</view><view class="intro">教学图文、公开视频与课程信息。</view><input class="search" placeholder="搜索教学内容" value="{{q}}" bindinput="search"/><scroll-view scroll-x class="filters"><view wx:for="{{filters}}" wx:key="*this" class="filter {{selected===item?'on':''}}" data-filter="{{item}}" bindtap="select">{{item}}</view></scroll-view><template is="state" data="{{loading,error}}"/><view class="card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><image class="cover" src="{{item.cover}}" mode="aspectFill"/><view class="card-body"><view class="tag">{{item.type==='video'?'公开视频':item.type==='course'?'课程信息':'图文教学'}}</view><view class="h3">{{item.name}}</view><view class="muted">{{item.category}}</view></view></view><view wx:if="{{!loading && !error && !items.length}}" class="empty">暂无内容，敬请期待。</view></view>
