@import "../../custom-tab-bar/index.wxss";
/* Page-local brand shell: follows the accepted tour page without changing global styles. */
.visitor-page {
  min-height: 100vh;
  padding-bottom: calc(52px + env(safe-area-inset-bottom));
  background: #f5eddd;
  color: #403326;
}
.visitor-page .visitor-brand {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 24rpx;
  height: 55px;
  padding: 0 40rpx;
  background: #3c2b24;
}
.visitor-page .visitor-logo {
  flex-shrink: 0;
  width: 139.2rpx;
  height: 86.4rpx;
  background: transparent;
  border-radius: 4rpx;
}
.visitor-page .visitor-brand-name {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  white-space: nowrap;
  text-align: center;
  color: #fff;
  font-family: "Microsoft YaHei", "微软雅黑", "PingFang SC", sans-serif;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1.4;
  letter-spacing: 1rpx;
}
@media (max-width: 320px) {
  .visitor-page .visitor-brand { gap: 20rpx; }
  .visitor-page .visitor-brand-name { font-size: 32rpx; }
}

.teaching-title-row { display: flex; align-items: baseline; gap: 20rpx; }
.teaching-title-row .h3 { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.teaching-duration { flex-shrink: 0; color: #6c5948; font-size: 26rpx; font-variant-numeric: tabular-nums; }

/* Video thumbnails use a responsive 16:9 viewport; source assets are unchanged. */
.teaching-video-cover { position: relative; width: 100%; padding-top: 56.25%; }
.teaching-video-cover .cover { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
