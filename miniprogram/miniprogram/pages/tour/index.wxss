.tour-page {
  min-height: 100vh;
  padding-bottom: calc(52px + env(safe-area-inset-bottom));
  background: #f5eddd;
  color: #403326;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}
.tour-page .tour-brand {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 24rpx;
  height: 55px;
  padding: 0 40rpx;
  background: rgba(60, 43, 36, 0.9);
}
.tour-page .tour-logo {
  flex-shrink: 0;
  width: 139.2rpx;
  height: 86.4rpx;
  background: transparent;
  border-radius: 4rpx;
}
.tour-page .tour-brand-name {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  white-space: nowrap;
  text-align: center;
  color: #fff;
  font-family: "Microsoft YaHei", "微软雅黑", "PingFang SC", sans-serif;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1.4;
  letter-spacing: 1rpx;
}
.tour-page .tour-content { padding: 20px 28rpx 24px; }
.tour-page .tour-intro { margin-bottom: 20px; font-size: 13px; line-height: 24px; }
.tour-page .tour-stop {
  margin-bottom: 22px;
  overflow: hidden;
  border: 1px solid #e5d2b3;
  border-radius: 16px;
  background: #fbf7ee;
}
.tour-page .tour-gallery { width: 100%; height: 190px; background: #e5dccb; }
.tour-page .tour-photo { display: block; width: 100%; height: 100%; }
.tour-page .tour-stop-body { padding: 14px 16px; }
.tour-page .tour-number {
  margin-bottom: 4px;
  color: #916824;
  font-family: Georgia, serif;
  font-size: 13px;
  line-height: 20px;
  letter-spacing: 2px;
}
.tour-page .tour-stop-name {
  margin-bottom: 8px;
  font-family: "Songti SC", STSong, "Noto Serif CJK SC", serif;
  font-size: 18px;
  font-weight: 600;
  line-height: 27px;
  overflow-wrap: break-word;
}
.tour-page .tour-description { font-size: 13px; line-height: 23px; overflow-wrap: break-word; }
.tour-page .tour-opening, .tour-page .tour-visit-note {
  margin-top: 10px;
  color: #6c5948;
  font-size: 12px;
  line-height: 21px;
  overflow-wrap: break-word;
}
.tour-page .tour-support { padding: 4px 2px 0; color: #6c5948; font-size: 12px; line-height: 22px; }
.tour-page .loading, .tour-page .empty { padding: 48px 12px; color: #6c5948; font-size: 14px; line-height: 24px; }
.tour-page .error { margin: 14px 0; padding: 16px; border-radius: 12px; font-size: 14px; line-height: 24px; color: #a13e35; }
.tour-page .error button.secondary { min-height: 44px; font-size: 14px; color: #3c2b24; border-color: #826742; }
@media (max-width: 320px) {
  .tour-page .tour-brand { gap: 20rpx; }
  .tour-page .tour-brand-name { font-size: 32rpx; }
  .tour-page .tour-stop-body { padding-right: 14px; padding-left: 14px; }
}
