{
  "name": "huangqiao-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --env-file-if-exists=.env server/index.mjs",
    "dev:admin": "vite admin --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build admin && tsc --noEmit -p miniprogram/tsconfig.json",
    "typecheck": "tsc --noEmit -p miniprogram/tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "verify:originals": "python3 scripts/verify_originals.py",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "restore": "node --env-file-if-exists=.env scripts/restore.mjs",
    "account:create": "node --env-file-if-exists=.env scripts/create-account.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate-pg.mjs",
    "build:mini": "node scripts/build-mini.mjs",
    "mini:prepare": "node scripts/prepare-mini-environments.mjs"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "miniprogram-automator": "^0.12.1",
    "typescript": "5.9.3",
    "vite": "7.1.7"
  }
}
